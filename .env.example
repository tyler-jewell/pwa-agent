# Optional — Web Push (Deploy Button works without these)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
NOTIFY_SECRET=

# Optional — durable push subscriptions (Vercel KV / Upstash REST)
# Without these, api uses in-memory dev fallback (not multi-instance safe).
KV_REST_API_URL=
KV_REST_API_TOKEN=
